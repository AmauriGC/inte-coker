# Normaliza fines de línea: en el repo siempre LF
* text=auto

# Scripts que corren en Linux (Docker/Jenkins): siempre LF
*.sh text eol=lf
mvnw text eol=lf
Dockerfile text eol=lf
Jenkinsfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.template text eol=lf
jenkins/plugins.txt text eol=lf

# Scripts de Windows: CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# Binarios (modelos 3D e imágenes)
*.glb binary
*.gltf binary
*.blend binary
*.png binary
*.jpg binary
*.webp binary
