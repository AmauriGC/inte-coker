# Servidor del front en Docker. Plantilla: nginx reemplaza ${BACK_URL} al arrancar.

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml application/manifest+json;

    # DNS interno de Docker: resuelve "back" en cada petición, aunque el back reinicie.
    resolver 127.0.0.11 valid=30s ipv6=off;
    set $back ${BACK_URL};

    # API y archivos subidos: al back. Se quita Origin, como el proxy de Vite en desarrollo,
    # porque para el navegador es la misma dirección y no hace falta CORS.
    location /api/ {
        proxy_pass $back;
        proxy_set_header Host $host;
        proxy_set_header Origin "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 60m;
        proxy_read_timeout 120s;
    }

    location /uploads/ {
        proxy_pass $back;
        proxy_set_header Host $host;
        proxy_set_header Origin "";
    }

    # Archivos con hash: no cambian nunca.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # El service worker, el manifest y el index se revisan siempre (si no, no llega la versión nueva).
    location = /sw.js {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location = /manifest.webmanifest {
        default_type application/manifest+json;
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    # SPA: cualquier ruta que no sea archivo responde index.html.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
