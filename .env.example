# ============================================================
#  Variables de entorno del proyecto (back + front)
#  Copia este archivo como .env y llena los valores reales.
#  IMPORTANTE: sin comillas y sin espacios alrededor del "=".
# ============================================================

# ---------- Servidor ----------
SERVER_PORT=8080
# URL del front: se usa para CORS y para los enlaces de los correos
FRONTEND_URL=http://localhost:5173

# ---------- Base de datos (MySQL) ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=catalogo_muebles
# Base solo para las pruebas (./mvnw verify); se crea y se borra en cada corrida
DB_NAME_TEST=catalogo_muebles_test
DB_USERNAME=root
DB_PASSWORD=tu_password_de_mysql

# ---------- JWT ----------
# Clave en Base64 de al menos 64 bytes. Genera una con PowerShell:
# $b=New-Object byte[] 64;[Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b);[Convert]::ToBase64String($b)
JWT_SECRET=cambia_esto_por_una_clave_base64_larga
# Duración del access token (ms) -> 1 hora
JWT_EXPIRATION_MS=3600000
# Duración del refresh token (ms) -> 7 días
JWT_REFRESH_EXPIRATION_MS=604800000

# ---------- Correo (Gmail con contraseña de aplicación) ----------
# Contraseña de aplicación: https://myaccount.google.com/apppasswords
# false = no se envía nada; el enlace del correo se escribe en el log del back
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=xxxxxxxxxxxxxxxx
MAIL_FROM=tu_correo@gmail.com

# ---------- Usuario administrador inicial ----------
ADMIN_EMAIL=admin@catalogo.com
ADMIN_PASSWORD=Admin123*

# ---------- Archivos subidos (modelos .glb e imágenes) ----------
# Relativo al directorio desde el que arranca el back. Si usas IntelliJ, conviene una ruta
# absoluta (por ejemplo C:/ruta/al/repo/back/uploads) para no depender del Working directory.
UPLOADS_DIR=uploads
# true = al arrancar agrega los muebles de ejemplo que falten (modelos de Blender, por slug)
SEMILLA_CATALOGO=true

# ---------- Front (Vite solo expone variables que empiezan con VITE_) ----------
VITE_API_URL=http://localhost:8080/api

# ---------- Docker (docker compose up -d --build) ----------
# Puertos en la laptop: front (nginx, reenvía /api al back) y back (Swagger y health).
# MySQL corre dentro de Docker con DB_PASSWORD como contraseña de root.
FRONT_PORT=8088
BACK_PORT=8089

# ---------- Jenkins (docker compose -f jenkins/docker-compose.yml --env-file .env up -d --build) ----------
JENKINS_PORT=8090
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=cambia-esta-contrasena
